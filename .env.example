# ===========================================
# HomeChef Environment Configuration
# Kopiere diese Datei als .env und passe die
# Werte an. Niemals die .env committen!
# ===========================================

# === HomeChef Image Version ===
HOMECHEF_TAG=latest

# === Database ===
POSTGRES_USER=homechef
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=homechef
DATABASE_URL=postgresql://homechef:CHANGE_ME_STRONG_PASSWORD@rezept_db:5432/homechef

# === API Keys ===
DASHSCOPE_API_KEY=
SPOONACULAR_API_KEY=
DEEPL_KEY=

# === Ports ===
FRONTEND_PORT=81
BACKEND_PORT=3005
